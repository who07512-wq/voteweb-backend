{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "HTTP Requests / sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "showPoints": "never"
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(campusvote_http_requests_total{job=\"campusvote-backend-api\"}[1m]))",
          "legendFormat": "all",
          "refId": "A"
        },
        {
          "expr": "sum by (method) (rate(campusvote_http_requests_total{job=\"campusvote-backend-api\"}[1m]))",
          "legendFormat": "{{method}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(campusvote_http_errors_total{job=\"campusvote-backend-api\"}[5m])) / clamp_min(sum(rate(campusvote_http_requests_total{job=\"campusvote-backend-api\"}[5m])), 1e-9)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Request Latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(campusvote_http_request_duration_seconds_bucket{job=\"campusvote-backend-api\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "title": "CPU %",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"campusvote-backend-api\"}[1m]) * 100",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Heap Used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes{job=\"campusvote-backend-api\"}",
          "legendFormat": "heap",
          "refId": "A"
        }
      ]
    },
    {
      "title": "HTTP Active Requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "campusvote_http_requests_active{job=\"campusvote-backend-api\"}",
          "legendFormat": "active",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Database Pool",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "campusvote_database_connections_total{job=\"campusvote-backend-api\"}",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "expr": "campusvote_database_connections_idle{job=\"campusvote-backend-api\"}",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "campusvote_database_connections_waiting{job=\"campusvote-backend-api\"}",
          "legendFormat": "waiting",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Votes Cast (rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(campusvote_votes_cast_total{job=\"campusvote-backend-api\"}[1m]))",
          "legendFormat": "votes/min",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["campusvote", "monitoring"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "CampusVote System Overview",
  "uid": "campusvote-system-overview",
  "version": 1
}